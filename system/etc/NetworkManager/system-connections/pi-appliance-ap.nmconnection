# Point d'accès Wi-Fi « pi-appliance », ouvert (sans mot de passe) : rien de
# sensible n'y passe en clair, la console est en HTTPS. Ouvert et fermé par
# ap.sh, jamais automatiquement par NetworkManager. Mode « shared » : le Pi
# prend l'adresse 10.42.0.1 et distribue les adresses (dnsmasq).

[connection]
id=pi-appliance-ap
uuid=6f1c5e1e-3d4b-4a8e-9a43-5d2b0c7e1a01
type=wifi
interface-name=wlan0
autoconnect=false

[wifi]
mode=ap
ssid=pi-appliance
# 2,4 GHz, canal 6 : permis dans tous les pays, compris par tous les téléphones.
band=bg
channel=6

[ipv4]
method=shared
address1=10.42.0.1/24

[ipv6]
method=disabled
