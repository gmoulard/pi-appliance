# Adresses <service>-<nom>.local des services installés : annonce mDNS et
# certificat de chacune (mdns.sh, spécification 4).

[Unit]
Description=Annonce mDNS des services pi-appliance
Documentation=https://github.com/gmoulard/pi-appliance
Wants=avahi-daemon.service
After=avahi-daemon.service NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/lib/pi-appliance/mdns.sh
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
