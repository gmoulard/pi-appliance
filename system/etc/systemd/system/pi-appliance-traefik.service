# Traefik, point d'entrée unique sur les ports 80 et 443 (traefik.sh, compose.yaml).
# Docker relance le conteneur s'il s'arrête (restart: always).

[Unit]
Description=Traefik, point d'entrée HTTPS de pi-appliance
Documentation=https://github.com/gmoulard/pi-appliance
Requires=docker.service pi-appliance-secrets.service
After=docker.service pi-appliance-secrets.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pi-appliance/traefik.sh start
ExecStop=/usr/local/lib/pi-appliance/traefik.sh stop
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
