# Secrets propres à ce Pi : clé du Pi et certificat local (secrets.sh). Lancé à
# chaque démarrage ; ne crée que ce qui manque ou expire.

[Unit]
Description=Secrets propres à ce pi-appliance (clé du Pi, certificat local)
After=local-fs.target
# Nom du Pi (name.sh) posé avant le réseau : nom d'hôte, avahi, Wi-Fi de configuration.
Before=pi-appliance.service pi-appliance-traefik.service NetworkManager.service avahi-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/lib/pi-appliance/name.sh boot
ExecStart=/usr/local/lib/pi-appliance/secrets.sh

[Install]
WantedBy=multi-user.target
