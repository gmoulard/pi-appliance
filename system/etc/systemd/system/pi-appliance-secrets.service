# Secrets propres à ce Pi : clé du Pi et certificat local (secrets.sh). Lancé à
# chaque démarrage ; ne crée que ce qui manque ou expire.

[Unit]
Description=Secrets propres à ce pi-appliance (clé du Pi, certificat local)
After=local-fs.target
Before=pi-appliance.service pi-appliance-traefik.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pi-appliance/secrets.sh

[Install]
WantedBy=multi-user.target
