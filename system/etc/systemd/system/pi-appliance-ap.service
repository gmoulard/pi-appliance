# Point d'accès Wi-Fi « pi-appliance » et ses 24 heures (ap.sh, spécification 4).

[Unit]
Description=Point d'accès Wi-Fi de configuration pi-appliance
Documentation=https://github.com/gmoulard/pi-appliance
# Jamais de Wi-Fi ouvert sans le pare-feu qui l'isole de la maison et d'internet.
Requires=NetworkManager.service pi-appliance-firewall.service
After=NetworkManager.service pi-appliance-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/lib/pi-appliance/ap.sh
# Pas de Wi-Fi sur le Pi : ap.sh s'arrête normalement, sans relance.
Restart=on-failure
RestartSec=10s
# /run/pi-appliance : état des 24 heures, effacé au redémarrage du Pi seulement.
RuntimeDirectory=pi-appliance
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
