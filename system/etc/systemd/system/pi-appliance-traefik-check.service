# Recharge l'image de Traefik depuis l'archive quand il redémarre en boucle
# (traefik.sh check), lancé par pi-appliance-traefik-check.timer.

[Unit]
Description=Vérification de Traefik (redémarrage en boucle)
Documentation=https://github.com/gmoulard/pi-appliance
Requires=docker.service
After=docker.service pi-appliance-traefik.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-appliance/traefik.sh check
TimeoutStartSec=5min
