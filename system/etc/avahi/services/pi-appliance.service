<!-- Annonce de la console sur le réseau de la maison (mDNS) : le nom
     pi-appliance.local est annoncé par avahi lui-même (nom d'hôte). -->
<service-group>
  <name replace-wildcards="yes">pi-appliance (%h)</name>
  <service>
    <type>_https._tcp</type>
    <port>443</port>
    <txt-record>path=/pi-appliance/</txt-record>
  </service>
</service-group>
